{
  "kind": "word-format-cover-layout",
  "version": "1.0",
  "different_first_page": true,
  "blocks": [
    {
      "field": "university_name",
      "when": "university_name",
      "tokens": {
        "font_latin": "Times New Roman",
        "first_line_indent_chars": 0,
        "font_east_asia": "华文中宋",
        "font_size_pt": 26,
        "alignment": "center",
        "bold": true,
        "space_before_pt": 40,
        "space_after_pt": 12
      }
    },
    {
      "field": "degree_type",
      "tokens": {
        "font_latin": "Times New Roman",
        "first_line_indent_chars": 0,
        "font_east_asia": "黑体",
        "font_size_pt": 24,
        "alignment": "center",
        "bold": true,
        "space_before_pt": 60,
        "space_after_pt": 45
      }
    },
    {
      "field": "title_cn",
      "tokens": {
        "font_latin": "Times New Roman",
        "first_line_indent_chars": 0,
        "font_east_asia": "黑体",
        "font_size_pt": 18,
        "alignment": "center",
        "bold": true,
        "color": "000000",
        "space_before_pt": 10,
        "space_after_pt": 14,
        "line_spacing": {
          "kind": "multiple",
          "value": 1.3
        }
      }
    },
    {
      "field": "title_en",
      "when": "title_en",
      "tokens": {
        "font_latin": "Times New Roman",
        "first_line_indent_chars": 0,
        "font_east_asia": "Times New Roman",
        "font_size_pt": 12,
        "alignment": "center",
        "bold": true,
        "color": "000000",
        "space_before_pt": 0,
        "space_after_pt": 45,
        "line_spacing": {
          "kind": "multiple",
          "value": 1.2
        }
      }
    }
  ],
  "field_table": {
    "widths_mm": [
      42,
      85
    ],
    "alignment": "center",
    "label": {
      "font_latin": "Times New Roman",
      "first_line_indent_chars": 0,
      "font_east_asia": "宋体",
      "font_size_pt": 14,
      "alignment": "right",
      "bold": true,
      "line_spacing": {
        "kind": "exact",
        "value": 28
      },
      "space_before_pt": 4,
      "space_after_pt": 4
    },
    "value": {
      "font_latin": "Times New Roman",
      "first_line_indent_chars": 0,
      "font_east_asia": "宋体",
      "font_size_pt": 14,
      "alignment": "center",
      "line_spacing": {
        "kind": "exact",
        "value": 28
      },
      "space_before_pt": 4,
      "space_after_pt": 4
    },
    "value_border": {
      "val": "single",
      "sz": "6",
      "space": "0",
      "color": "000000"
