  "date": {
    "field": "date_str",
    "tokens": {
      "font_latin": "Times New Roman",
      "first_line_indent_chars": 0,
      "font_east_asia": "宋体",
      "font_size_pt": 14,
      "alignment": "center",
      "bold": true,
      "space_before_pt": 48,
      "space_after_pt": 0
